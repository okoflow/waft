{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waft",
  "version": "1.0.0",
  "identifier": "com.okoflow.waft",
  "build": {
    "beforeDevCommand": {
      "script": "bun run --filter @waft/ui dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "bun run --filter @waft/ui build",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Waft",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 The Waft Authors",
    "license": "GPL-3.0-only",
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
