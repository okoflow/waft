--allow-partial-wrapping  false
--computed-var-attributes prev-line
--extension-acl           on-declarations
--func-attributes         prev-line
--header                  strip
--language-mode           6
--mark-categories         false
--max-width               130
--organization-mode       type
--organize-types          actor,class,enum,extension,protocol,struct
--preserve-acronyms       convertIdToToken,convertTokenToId,tokenIds
--sort-swiftui-properties first-appearance-sort
--stored-var-attributes   same-line
--strip-unused-args       closure-only
--swift-version           6.3
--type-attributes         prev-line
--type-body-marks         remove
--wrap-arguments          before-first
--wrap-collections        before-first
--wrap-conditions         after-first
--wrap-effects            never
--wrap-return-type        never

--min-version 0.63.1

--enable                             \
  acronyms,                          \
  blankLineAfterSwitchCase,          \
  blankLinesAfterGuardStatements,    \
  isEmpty,                           \
  noGuardInTests,                    \
  organizeDeclarations,              \
  preferContains,                    \
  preferCountWhere,                  \
  preferFinalClasses,                \
  preferFirstWhere,                  \
  preferMinOverSorted,               \
  singlePropertyPerLine,             \
  testSuiteAccessControl,            \
  validateTestCases,                 \
  wrapEnumCases,                     \
  wrapMultilineConditionalAssignment

--disable                      \
  environmentEntry,            \
  wrapMultilineStatementBraces
